# Pixora 环境变量示例。复制为 .env 后按注释填。
#
# 存储路径这类配置只走环境变量，不在界面上开放写入（ADR-0003）：
# 容器里的挂载点是编排文件决定的，界面改了也写不进去；而配置文件一旦可写，
# 就等于给了一个远程改服务器目录的入口。
#
# 数据库与图片存储的选型见 README 的「部署」一节：
#   数据库：SQLite 文件 / 自建 PostgreSQL、MySQL / 云上托管（Neon、Supabase、RDS、PolarDB…）
#   图片：本地目录 / S3 兼容对象存储（R2、OSS、COS、MinIO、B2）/ WebDAV / GitHub / Telegram
# 图片存储后端在后台界面里配（凭据加密入库），本文件只管进程启动参数。

# ---------- 必填 ----------

# 站点域名。Caddy 用它申请证书，应用用它拼直链。
PIXORA_DOMAIN=img.example.com
ACME_EMAIL=admin@example.com

# 数据库密码（只有用编排里那个自建 Postgres 时才需要）
POSTGRES_PASSWORD=change-me-to-a-strong-password

# 加密主密钥：用于加密存储后端凭据与 SMTP 密码。
# 生成一把：openssl rand -hex 32
# 注意：换掉它会让已加密的凭据全部失效（需要重新填写 SMTP 密码与后端 Token）。
PIXORA_MASTER_KEY=

# ---------- 数据库 ----------

# postgres / mysql / sqlite
PIXORA_DB_DRIVER=postgres
# SQLite 时填文件路径，例如 /data/pixora.db。
# 用托管数据库就直接贴厂商给的连接串，SSL 参数照抄：
#    Neon / Vercel Postgres / Supabase：
#      postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
#    阿里云 RDS / 腾讯云 CDB：
#      postgres://user:pass@pgm-xxx.pg.rds.aliyuncs.com:5432/pixora?sslmode=require
#    MySQL 系（云厂商 MySQL、PlanetScale）：
#      mysql://user:pass@host:3306/pixora?ssl-mode=REQUIRED
PIXORA_DB_DSN=

# ---------- 站点 ----------

# 反向代理后面必须显式设置，否则直链会指向容器内网地址。
# 前后端分开部署时更要设对：直链、OAuth 回跳、站点资产地址都按它拼。
PIXORA_BASE_URL=https://img.example.com
PIXORA_TRUST_PROXY=1
# 让 Caddy 直接发文件（配合 Caddyfile 里的 /data-files 路径）
PIXORA_ACCEL_PREFIX=/data-files

# ---------- 前后端分开部署（可选） ----------

# 前端托管在别的域名上时（Vercel / Cloudflare Pages / EdgeOne Makers），
# 把那些来源逐个写上，逗号分隔。应用只对名单里的来源回跨域头，
# 同时把它们当作可信前端：OAuth 授权完会跳回那边，而不是落在 API 域名的首页。
# 例：PIXORA_CORS_ORIGINS=https://pixora.vercel.app,https://pixora.pages.dev
# 注意：不接受 `*`——带凭据的跨域本来就不允许通配。
PIXORA_CORS_ORIGINS=

# 会话 Cookie 的 SameSite。不填时：配了 CORS_ORIGINS 就是 none（跨站要用），
# 否则 lax（同源）。跨站时强制带 Secure，所以前后端都得走 https。
# PIXORA_COOKIE_SAMESITE=lax

# ---------- 运行时 ----------

PIXORA_BIND=0.0.0.0:8080
PIXORA_DATA_DIR=/data
# 队列 worker 数，留空即等于 CPU 核数
PIXORA_WORKERS=4
PIXORA_DB_MAX_CONNECTIONS=10
RUST_LOG=info

# ---------- 开发用（生产不要开） ----------

# 前端读盘而不是读嵌入产物，改一行刷新即可
# PIXORA_WEB_DIR=./web/dist
# 本地 HTTP 调试时 Cookie 不带 Secure
# PIXORA_SECURE_COOKIES=false
# 把邮箱验证码放进接口响应里（本机联调省得翻日志）
# PIXORA_DEV_RETURN_CODES=true

# ---------- 前端构建期变量（不是服务端变量） ----------

# 交给静态托管、CI 或 docker build 去构建前端时，用它把接口指向后端；
# 与后端同源就留空。产物里会写成一行 config.js，部署之后也能直接改。
# PIXORA_API_BASE=https://img-api.example.com
